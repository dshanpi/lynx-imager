# DshanPI LYNX - Canaan Kendryte K230 BootROM / USB download gadget
# Both BootROM and the temporary loader use 29f1:0230.
SUBSYSTEM=="usb", ATTR{idVendor}=="29f1", ATTR{idProduct}=="0230", MODE="0666"

# Rockchip Maskrom / Loader devices (the PID identifies the SoC family).
SUBSYSTEM=="usb", ATTR{idVendor}=="2207", MODE="0666"

# STMicroelectronics STM32 system-memory USB DFU bootloader.
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Lynx Power multi-protocol controllers. Grant raw USB access to the GPIO,
# I2C and SPI interface while the CDC UART interfaces remain managed normally.
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="55de", MODE="0660", GROUP="plugdev", TAG+="uaccess"
