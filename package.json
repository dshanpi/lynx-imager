{
  "name": "lynx-imager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-python-runtime.mjs && node scripts/fetch-openocd-runtime.mjs && node scripts/fetch-ch347-runtime.mjs && node scripts/sync-version.js && node scripts/check-input-safety.mjs && node scripts/check-ui-scale.mjs && node scripts/validate-ui-constraints.mjs && node scripts/validate-skills-index.mjs && node scripts/validate-package-config.js && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "init": "node scripts/init.js",
    "dist": "node scripts/sync-version.js && npx i18next-cli extract && npx i18next-cli status",
    "sync-version": "node scripts/sync-version.js",
    "validate:package": "node scripts/check-input-safety.mjs && node scripts/validate-skills-index.mjs && node scripts/validate-package-config.js",
    "check:input-safety": "node scripts/check-input-safety.mjs",
    "check:ui-scale": "node scripts/check-ui-scale.mjs",
    "check:ui-constraints": "node scripts/validate-ui-constraints.mjs",
    "gate:startup-visual": "bash scripts/verify-startup-visual",
    "gate:business-logic-ui": "bash scripts/verify-business-logic-ui",
    "gate:ssh-terminal-runtime": "bash scripts/verify-ssh-terminal-runtime",
    "gate:ai-supervisor-runtime": "bash scripts/verify-ai-supervisor-runtime",
    "check:ipc-contracts": "node scripts/check-ipc-contracts.mjs",
    "validate:release": "node scripts/validate-release-version.mjs",
    "prepare:openocd:release": "node scripts/fetch-openocd-runtime.mjs --target=linux-x86_64 && node scripts/fetch-openocd-runtime.mjs --target=windows-x86_64",
    "i18n:extract": "npx i18next-cli extract",
    "i18n:status": "npx i18next-cli status",
    "i18n:lint": "npx i18next-cli lint",
    "i18n:types": "npx i18next-cli types",
    "typecheck": "npx tsc --noEmit",
    "test:ui-contract": "node --test tests/imager",
    "test:imager": "node --test tests/imager",
    "test:release-assets": "node --test tests/release-assets.test.mjs tests/release-reset.test.mjs tests/windows-delivery-zip.test.mjs tests/github-publication.test.mjs tests/release-sidecar-pin.test.mjs",
    "build:windows-delta": "node scripts/build-windows-delta.mjs",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "release:stage": "bash scripts/publish-release-tag.sh",
    "release:publish": "bash scripts/publish-release-tag.sh",
    "lint": "eslint src --report-unused-disable-directives",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "verify:baseline": "bash scripts/verify-baseline",
    "verify:changed": "bash scripts/verify-changed",
    "verify:module": "bash scripts/verify-module",
    "verify:all": "bash scripts/verify-all",
    "verify:hil-smoke": "bash scripts/verify-hil-smoke",
    "verify:hil-ch347-monitor": "node scripts/verify-ch347-monitor-hil.mjs",
    "verify:release": "bash scripts/verify-release",
    "build:learn-client": "node scripts/build-learn-client.mjs",
    "gate:github-publication": "node scripts/verify-github-publication.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-icons": "^2.0.339",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "monaco-editor": "^0.55.1",
    "parse5": "8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "i18next-cli": "^1.42.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "3.3.18"
  }
}
