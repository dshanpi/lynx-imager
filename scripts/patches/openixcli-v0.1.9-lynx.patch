+    fn reconnect_accepts_one_same_bus_and_leaf_migration() {
+        let devices = vec![scanned("libusb:2:4.2")];
+        let (matching, rule) = reconnect_location_candidates("libusb:2:3.2", &devices);
+        assert_eq!(rule, Some("same-bus-same-leaf-unique"));
+        assert_eq!(matching.len(), 1);
+        assert_eq!(matching[0].location_path.as_deref(), Some("libusb:2:4.2"));
+    }
+
+    #[test]
+    fn reconnect_exposes_ambiguous_migrations_for_the_caller_to_reject() {
+        let devices = vec![scanned("libusb:2:4.2"), scanned("libusb:2:5.2")];
+        let (matching, rule) = reconnect_location_candidates("libusb:2:3.2", &devices);
+        assert_eq!(rule, Some("same-bus-same-leaf-unique"));
+        assert_eq!(matching.len(), 2);
+    }
+
+    #[test]
+    fn reconnect_does_not_migrate_across_usb_buses() {
+        let devices = vec![scanned("libusb:3:4.2")];
+        let (matching, rule) = reconnect_location_candidates("libusb:2:3.2", &devices);
+        assert_eq!(rule, Some("same-bus-unique-fes-transition"));
+        assert!(matching.is_empty());
+    }
+
+    #[test]
+    fn reconnect_ignores_a_topology_match_with_the_wrong_usb_identity() {
+        let mut device = scanned("libusb:2:4.2");
+        device.vid = 0x1234;
+        let devices = vec![device];
+        let (matching, rule) = reconnect_location_candidates("libusb:2:3.2", &devices);
+        assert_eq!(rule, Some("same-bus-unique-fes-transition"));
+        assert!(matching.is_empty());
+    }
+
+    #[test]
+    fn reconnect_accepts_one_same_bus_fes_when_the_leaf_changes() {
+        assert!(same_libusb_bus("libusb:2:3.2", "libusb:2:4.1"));
+        let devices = vec![scanned("libusb:2:4.1")];
+        let (matching, rule) = reconnect_location_candidates("libusb:2:3.2", &devices);
+        assert_eq!(rule, Some("same-bus-unique-fes-transition"));
+        assert_eq!(matching.len(), 1);
+    }
+
+    #[test]
+    fn reconnect_rejects_multiple_same_bus_fes_transition_candidates() {
+        let devices = vec![scanned("libusb:2:4.1"), scanned("libusb:2:5.3")];
+        let (matching, rule) = reconnect_location_candidates("libusb:2:3.2", &devices);
+        assert_eq!(rule, Some("same-bus-unique-fes-transition"));
+        assert_eq!(matching.len(), 2);
+    }
+
+    #[test]
+    fn windows_location_migrates_only_to_the_unique_libusb_fes_candidate() {
+        let expected = "PCIROOT(0)#PCI(1400)#USBROOT(0)#USB(4)";
+        let devices = vec![scanned("libusb:2:4.1")];
+        let (matching, rule) = reconnect_location_candidates(expected, &devices);
+        assert_eq!(
+            rule,
+            Some("windows-location-to-unique-libusb-fes-transition")
+        );
+        assert_eq!(matching.len(), 1);
+        assert_eq!(matching[0].location_path.as_deref(), Some("libusb:2:4.1"));
+    }
+
+    #[test]
+    fn windows_location_rejects_ambiguous_libusb_fes_candidates() {
+        let expected = "PCIROOT(0)#PCI(1400)#USBROOT(0)#USB(4)";
+        let devices = vec![scanned("libusb:2:4.1"), scanned("libusb:3:7.2")];
+        let (matching, rule) = reconnect_location_candidates(expected, &devices);
+        assert_eq!(
+            rule,
+            Some("windows-location-to-unique-libusb-fes-transition")
+        );
+        assert_eq!(matching.len(), 2);
+    }
+
+    #[test]
+    fn generic_vendor_fes_id_accepts_any_fel_soc_without_a_chip_whitelist() {
+        for fel_device_id in [0x0018_2300, 0x0018_5500, 0x0018_5900, 0x0018_9000] {
+            assert!(fel_fes_device_ids_match(fel_device_id, 0x0016_1000));
+            assert!(fel_fes_device_ids_match(fel_device_id, fel_device_id));
+        }
+    }
+
+    #[test]
+    fn generic_vendor_fes_id_transition_is_one_way_and_rejects_other_id_changes() {
+        assert!(!fel_fes_device_ids_match(0x0016_1000, 0x0018_2300));
+        assert!(!fel_fes_device_ids_match(0x0018_2300, 0x0016_1001));
+    }
+
+    #[test]
+    fn post_action_retry_open_error_requires_confirmed_fes_exit() {
+        assert!(post_action_retry_open_error_is_success(true));
+        assert!(!post_action_retry_open_error_is_success(false));
+    }
+}
