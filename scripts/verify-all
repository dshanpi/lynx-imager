#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

npm run format:check
"$repo_root/scripts/verify-module"
npm run build
git diff --check

printf '%s\n' 'Software G3 checks passed.'
printf '%s\n' 'Target-platform install, signing, updater, visual/E2E, and applicable HIL evidence remain separate release gates.'
