#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

if [[ "$(uname -s)" == "Linux" && -z "${LYNX_BUSINESS_XVFB_ACTIVE:-}" ]]; then
  if ! command -v xvfb-run >/dev/null 2>&1; then
    printf '%s\n' 'Business logic UI gate failed: xvfb-run is required for the isolated Linux desktop.' >&2
    exit 1
  fi
  exec env LYNX_BUSINESS_XVFB_ACTIVE=1 xvfb-run -a -s '-screen 0 1920x1080x24' "$0"
fi

if ! command -v tauri-driver >/dev/null 2>&1; then
  printf '%s\n' 'Business logic UI gate failed: tauri-driver is required.' >&2
  exit 1
fi

if [[ "$(uname -s)" == "Linux" ]] && ! command -v WebKitWebDriver >/dev/null 2>&1; then
  printf '%s\n' 'Business logic UI gate failed: WebKitWebDriver is required.' >&2
  exit 1
fi

if [[ "${LYNX_BUSINESS_SKIP_BUILD:-0}" != "1" ]]; then
  npm run tauri build -- --debug --no-bundle
fi

node scripts/verify-business-logic-ui.mjs
