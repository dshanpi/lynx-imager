Unicode true

!include "LogicLib.nsh"

!ifndef DELTA_BUNDLE_DIR
  !error "DELTA_BUNDLE_DIR is required"
!endif
!ifndef DELTA_HELPER_EXE
  !error "DELTA_HELPER_EXE is required"
!endif
!ifndef OUTPUT_FILE
  !error "OUTPUT_FILE is required"
!endif
!ifndef FROM_VERSION
  !error "FROM_VERSION is required"
!endif
!ifndef PRODUCT_VERSION
  !error "PRODUCT_VERSION is required"
!endif
!ifndef PRODUCT_FILE_VERSION
  !define PRODUCT_FILE_VERSION "${PRODUCT_VERSION}.0"
!endif

!define PRODUCT_NAME "LYNX"
!define PRODUCT_BRAND "DshanPI LYNX｜芯桥"
!define PRODUCT_PUBLISHER "dshanpi"
!define PRODUCT_REG_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\LYNX"
!define PRODUCT_LOCATION_KEY "Software\dshanpi\LYNX"
!define LYNX_PROTOCOL_REG_KEY "Software\Classes\lynx"
!define FAILURE_MARKER_DIR "$APPDATA\com.dshanpi.lynx"
!define FAILURE_MARKER "${FAILURE_MARKER_DIR}\update-delta-failure"

Var PreviousInstallDir
Var PreviousVersion

Name "${PRODUCT_BRAND} ${FROM_VERSION} → ${PRODUCT_VERSION} 小版本更新"
OutFile "${OUTPUT_FILE}"
InstallDir "$LOCALAPPDATA\DshanPI\LYNX"
RequestExecutionLevel user
SetCompressor /SOLID lzma
SilentInstall silent
AutoCloseWindow true
Icon "..\src-tauri\icons\icon.ico"
UninstallIcon "..\src-tauri\icons\icon.ico"

VIProductVersion "${PRODUCT_FILE_VERSION}"
VIAddVersionKey /LANG=1033 "ProductName" "${PRODUCT_NAME}"
VIAddVersionKey /LANG=1033 "FileDescription" "${PRODUCT_BRAND} Delta Updater"
VIAddVersionKey /LANG=1033 "CompanyName" "${PRODUCT_PUBLISHER}"
VIAddVersionKey /LANG=1033 "LegalCopyright" "Copyright DshanPI"
VIAddVersionKey /LANG=1033 "FileVersion" "${PRODUCT_VERSION}"
VIAddVersionKey /LANG=1033 "ProductVersion" "${PRODUCT_VERSION}"

Function WriteFailureMarker
  Exch $0
  CreateDirectory "${FAILURE_MARKER_DIR}"
  FileOpen $1 "${FAILURE_MARKER}" w
  IfErrors failure_marker_done
  FileWrite $1 "$0$\r$\n"
  FileClose $1
  failure_marker_done:
  Pop $0
FunctionEnd

Function RelaunchPrevious
  StrCpy $1 "$LOCALAPPDATA\DshanPI\LYNX\app-"
  StrLen $2 $1
  StrCpy $3 $PreviousInstallDir $2
  StrCmp $3 $1 0 relaunch_previous_done
  IfFileExists "$PreviousInstallDir\lynx-imager.exe" 0 relaunch_previous_done
  Exec '"$PreviousInstallDir\lynx-imager.exe"'
  relaunch_previous_done:
FunctionEnd

Function FailPrecondition
  Push "PRECONDITION"
  Call WriteFailureMarker
  Call RelaunchPrevious
  SetErrorLevel 20
  Quit
FunctionEnd

Function FailCopy
  RMDir /r "$INSTDIR"
  Push "COPY"
  Call WriteFailureMarker
  Call RelaunchPrevious
  SetErrorLevel 21
  Quit
FunctionEnd

Function FailPatch
  RMDir /r "$INSTDIR"
  Push "PATCH"
  Call WriteFailureMarker
  Call RelaunchPrevious
  SetErrorLevel 22
  Quit
FunctionEnd

Function FailSelfTest
  RMDir /r "$INSTDIR"
  Push "SELF_TEST"
  Call WriteFailureMarker
  Call RelaunchPrevious
  SetErrorLevel 23
  Quit
FunctionEnd

Function .onInit
  SetShellVarContext current
  Delete "${FAILURE_MARKER}"
  ReadRegStr $PreviousInstallDir HKCU "${PRODUCT_LOCATION_KEY}" ""
  ReadRegStr $PreviousVersion HKCU "${PRODUCT_REG_KEY}" "DisplayVersion"
  StrCmp $PreviousVersion "${FROM_VERSION}" 0 precondition_failed
  StrCmp $PreviousInstallDir "" precondition_failed

  ; Never copy from an arbitrary registry-controlled directory. Delta updates
  ; are allowed only from a versioned LYNX program instance under LocalAppData.
  StrCpy $1 "$LOCALAPPDATA\DshanPI\LYNX\app-"
  StrLen $2 $1
  StrCpy $3 $PreviousInstallDir $2
  StrCmp $3 $1 previous_path_ok precondition_failed
  previous_path_ok:
    IfFileExists "$PreviousInstallDir\lynx-imager.exe" 0 precondition_failed
    System::Call 'kernel32::GetTickCount() i .r0'
    StrCpy $INSTDIR "$LOCALAPPDATA\DshanPI\LYNX\app-${PRODUCT_VERSION}-$0"
    Return
  precondition_failed:
    Call FailPrecondition
FunctionEnd

Function TryRemovePreviousInstall
  StrCmp $PreviousInstallDir "" previous_cleanup_done
  StrCmp $PreviousInstallDir "$INSTDIR" previous_cleanup_done
  StrCpy $1 "$LOCALAPPDATA\DshanPI\LYNX\app-"
  StrLen $2 $1
  StrCpy $3 $PreviousInstallDir $2
  StrCmp $3 $1 previous_cleanup_allowed previous_cleanup_done
  previous_cleanup_allowed:
    RMDir /r /REBOOTOK "$PreviousInstallDir"
  previous_cleanup_done:
FunctionEnd

Section "LYNX delta update" SEC_MAIN
  SetShellVarContext current

  ; Copying into a fresh instance keeps the currently running program intact.
  ; /XJ avoids following junctions; robocopy return values 0-7 are success.
  CreateDirectory "$INSTDIR"
  nsExec::ExecToStack '"$SYSDIR\robocopy.exe" "$PreviousInstallDir" "$INSTDIR" /E /COPY:DAT /DCOPY:DAT /R:1 /W:1 /XJ /NFL /NDL /NJH /NJS /NP'
  Pop $0
  Pop $1
  StrCmp $0 "error" delta_copy_failed
  IntCmp $0 8 delta_copy_failed delta_copy_ok delta_copy_failed
  delta_copy_failed:
    Call FailCopy
  delta_copy_ok:

  ; These files are generated by the installer and are deliberately outside
  ; the release payload tree checked by the delta manifest.
  Delete "$INSTDIR\uninstall.exe"
  Delete "$INSTDIR\bin\openixcli-version.txt"

  SetOutPath "$PLUGINSDIR\lynx-delta"
  File /oname=lynx-delta-helper.exe "${DELTA_HELPER_EXE}"
  SetOutPath "$PLUGINSDIR\lynx-delta\bundle"
  File /r "${DELTA_BUNDLE_DIR}\*"

  nsExec::ExecToStack '"$PLUGINSDIR\lynx-delta\lynx-delta-helper.exe" apply "$INSTDIR" "$PLUGINSDIR\lynx-delta\bundle" "${FROM_VERSION}" "${PRODUCT_VERSION}"'
  Pop $0
  Pop $1
  StrCmp $0 "0" delta_patch_ok
    DetailPrint "$1"
    Call FailPatch
  delta_patch_ok:

  IfFileExists "$INSTDIR\lynx-imager.exe" 0 delta_self_test_failed
  IfFileExists "$INSTDIR\bin\openixcli.exe" 0 delta_self_test_failed
  nsExec::ExecToStack '"$INSTDIR\bin\openixcli.exe" --version'
  Pop $0
  Pop $1
  StrCmp $0 "0" delta_self_test_ok
  delta_self_test_failed:
    Call FailSelfTest
  delta_self_test_ok:

  FileOpen $2 "$INSTDIR\bin\openixcli-version.txt" w
  IfErrors delta_self_test_failed
  FileWrite $2 "$1$\r$\nupdated-by: signed-delta-${FROM_VERSION}-to-${PRODUCT_VERSION}$\r$\n"
  FileClose $2
  SetOutPath "$INSTDIR"
  WriteUninstaller "$INSTDIR\uninstall.exe"

  ; Stop hardware helpers only after the fresh tree has passed every check.
  nsExec::ExecToLog 'taskkill /F /T /IM lynx-imager.exe'
  nsExec::ExecToLog 'taskkill /F /T /IM openixcli.exe'
  nsExec::ExecToLog 'taskkill /F /T /IM openrockcli.exe'
  nsExec::ExecToLog 'taskkill /F /T /IM uuu.exe'
  nsExec::ExecToLog 'taskkill /F /T /IM dfu-util.exe'

  Delete "$DESKTOP\LYNX.lnk"
  Delete "$SMPROGRAMS\LYNX.lnk"
  Delete "$SMPROGRAMS\DshanPI\LYNX.lnk"
  CreateShortcut "$SMPROGRAMS\LYNX.lnk" "$INSTDIR\lynx-imager.exe"
  CreateShortcut "$DESKTOP\LYNX.lnk" "$INSTDIR\lynx-imager.exe"

  WriteRegStr HKCU "${PRODUCT_LOCATION_KEY}" "" "$INSTDIR"
  WriteRegStr HKCU "${PRODUCT_LOCATION_KEY}" "PreviousInstallDir" "$PreviousInstallDir"
  WriteRegStr HKCU "${PRODUCT_REG_KEY}" "DisplayName" "${PRODUCT_BRAND}"
  WriteRegStr HKCU "${PRODUCT_REG_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr HKCU "${PRODUCT_REG_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
  WriteRegStr HKCU "${PRODUCT_REG_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${PRODUCT_REG_KEY}" "DisplayIcon" "$INSTDIR\lynx-imager.exe"
  WriteRegStr HKCU "${PRODUCT_REG_KEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr HKCU "${PRODUCT_REG_KEY}" "MainBinaryName" "lynx-imager.exe"
  WriteRegDWORD HKCU "${PRODUCT_REG_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${PRODUCT_REG_KEY}" "NoRepair" 1
  WriteRegStr HKCU "${LYNX_PROTOCOL_REG_KEY}" "" "URL:LYNX Learning Protocol"
  WriteRegStr HKCU "${LYNX_PROTOCOL_REG_KEY}" "URL Protocol" ""
  WriteRegStr HKCU "${LYNX_PROTOCOL_REG_KEY}\DefaultIcon" "" "$INSTDIR\lynx-imager.exe,0"
  WriteRegStr HKCU "${LYNX_PROTOCOL_REG_KEY}\shell\open\command" "" '"$INSTDIR\lynx-imager.exe" "%1"'

  Call TryRemovePreviousInstall
  Delete "${FAILURE_MARKER}"
  Exec '"$INSTDIR\lynx-imager.exe"'
  SetErrorLevel 0
SectionEnd

Section "Uninstall"
  SetShellVarContext current
  ReadRegStr $0 HKCU "${PRODUCT_LOCATION_KEY}" ""
  StrCmp $0 "$INSTDIR" uninstall_current uninstall_instance
  uninstall_current:
    Delete "$DESKTOP\LYNX.lnk"
    Delete "$SMPROGRAMS\LYNX.lnk"
    Delete "$SMPROGRAMS\DshanPI\LYNX.lnk"
    RMDir "$SMPROGRAMS\DshanPI"
    DeleteRegKey HKCU "${PRODUCT_REG_KEY}"
    DeleteRegKey HKCU "${LYNX_PROTOCOL_REG_KEY}"
    DeleteRegKey HKCU "${PRODUCT_LOCATION_KEY}"
  uninstall_instance:
    RMDir /r "$INSTDIR"
SectionEnd
